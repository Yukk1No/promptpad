# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local tool state
.omc/
.omm/

# Real-audio benchmark assets (regenerated by run_vosk.py / pipeline)
benchmark/real_audio/model/
benchmark/real_audio/model.zip
benchmark/real_audio/*.mp3
benchmark/real_audio/*.wav
benchmark/real_audio/*_raw.wiki

# Benchmark results (regenerated artifacts: events / traces / word_timings)
benchmark/results/

# Claude Code session-internal state
.claude/scheduled_tasks.lock
.claude/worktrees/

# Real-device calibration logs exported from Settings → Debug mode.
# These are user-specific captures, not artifacts to share between
# checkouts. Keep findings in benchmark/reports/ instead.
cadence-*.log
cadence-*.jsonl
