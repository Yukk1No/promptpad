graph TD
    exact["Exact Match\na == b"]
    phonetic["Phonetic Match\nMetaphone(a) == Metaphone(b)"]
    prefix["Prefix Match\nstartsWith + length check"]
    substring["Substring Match\ncontains, length >= 4"]
    common-prefix["Common Prefix\nshared >= 60% of shorter"]
    edit-dist["Edit Distance\nLevenshtein DP"]

    exact -->|"miss"| phonetic
    phonetic -->|"miss"| prefix
    prefix -->|"miss"| substring
    substring -->|"miss"| common-prefix
    common-prefix -->|"miss"| edit-dist

    classDef entry fill:#89b4fa,stroke:#89b4fa,color:#1e1e2e
    class exact entry
